{
  "version": 6,
  "configurePresets": [
    {
      "name": "cpu",
      "displayName": "CPU-only (skeleton / CI)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHELF_ENABLE_SYCL": "OFF",
        "SHELF_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "cpu", "configurePreset": "cpu" }
  ],
  "testPresets": [
    {
      "name": "cpu",
      "configurePreset": "cpu",
      "output": { "outputOnFailure": true }
    }
  ]
}
