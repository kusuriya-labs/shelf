{
  "version": 6,
  "configurePresets": [
    {
      "name": "cpu",
      "displayName": "CPU-only (skeleton / CI)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHELF_ENABLE_SYCL": "OFF",
        "SHELF_ENABLE_HIP": "OFF",
        "SHELF_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "hip",
      "displayName": "HIP backend (AMD ROCm, gfx1201)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/hip",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHELF_ENABLE_SYCL": "OFF",
        "SHELF_ENABLE_HIP": "ON",
        "SHELF_BUILD_TESTS": "ON",
        "CMAKE_HIP_ARCHITECTURES": "gfx1201"
      }
    },
    {
      "name": "hip-rel",
      "displayName": "HIP backend release (perf measurement)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/hip-rel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SHELF_ENABLE_SYCL": "OFF",
        "SHELF_ENABLE_HIP": "ON",
        "SHELF_BUILD_TESTS": "ON",
        "CMAKE_HIP_ARCHITECTURES": "gfx1201"
      }
    },
    {
      "name": "sycl",
      "displayName": "SYCL backend (AdaptiveCpp, AOT hip:gfx1201)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/sycl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHELF_ENABLE_SYCL": "ON",
        "SHELF_ENABLE_HIP": "OFF",
        "SHELF_BUILD_TESTS": "ON",
        "SHELF_SYCL_TARGETS": "hip:gfx1201"
      },
      "environment": {
        "ACPP_TARGETS": "hip:gfx1201"
      }
    },
    {
      "name": "sycl-cpu",
      "displayName": "SYCL backend (AdaptiveCpp, OpenMP device \u2014 host-API CI)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/sycl-cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHELF_ENABLE_SYCL": "ON",
        "SHELF_ENABLE_HIP": "OFF",
        "SHELF_BUILD_TESTS": "ON",
        "SHELF_SYCL_TARGETS": "omp"
      },
      "environment": {
        "ACPP_TARGETS": "omp"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cpu",
      "configurePreset": "cpu"
    },
    {
      "name": "hip",
      "configurePreset": "hip"
    },
    {
      "name": "hip-rel",
      "configurePreset": "hip-rel"
    },
    {
      "name": "sycl",
      "configurePreset": "sycl"
    },
    {
      "name": "sycl-cpu",
      "configurePreset": "sycl-cpu"
    }
  ],
  "testPresets": [
    {
      "name": "cpu",
      "configurePreset": "cpu",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "hip",
      "configurePreset": "hip",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "hip-rel",
      "configurePreset": "hip-rel",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sycl",
      "configurePreset": "sycl",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sycl-cpu",
      "configurePreset": "sycl-cpu",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
